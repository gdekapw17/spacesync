{
  "name": "backend",
  "version": "0.0.1",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write --no-error-on-unmatched-pattern \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
