# ==========================================
# APPLICATION & DATABASE CONFIGURATION
# ==========================================
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:spacesync_dev_password@localhost:5432/spacesync_db?schema=public"

# ==========================================
# AUTHENTICATION & JWT SECURITY (DUAL-TOKEN)
# ==========================================
JWT_ACCESS_SECRET="replace-with-a-secure-256-bit-secret-key-for-access-tokens"
JWT_ACCESS_EXPIRATION="15m"

JWT_REFRESH_SECRET="replace-with-a-secure-256-bit-secret-key-for-refresh-tokens"
JWT_REFRESH_EXPIRATION="7d"